---
interface Props {
  item: any;
  lang: 'zh' | 'en';
  showBody?: boolean;
}
const { item, lang, showBody = false } = Astro.props;

const typeColors = {
  paper: 'bg-accent/10 text-accent-dark',
  join: 'bg-coral/10 text-coral-dark',
  recruit: 'bg-coral/10 text-coral-dark',
  conference: 'bg-primary/10 text-primary',
  award: 'bg-yellow-100 text-yellow-700',
  team: 'bg-primary/10 text-primary',
};

const typeLabels = {
  zh: { paper: '论文', join: '加入', recruit: '招生', conference: '会议', award: '获奖', team: '团队' },
  en: { paper: 'Paper', join: 'Join', recruit: 'Recruit', conference: 'Conference', award: 'Award', team: 'Team' },
};
---

<article class="card card-hover p-6">
  <div class="flex items-center gap-3 mb-3">
    <span class={`px-2.5 py-1 text-xs rounded-full font-medium ${typeColors[item.type] || 'bg-primary/10 text-primary'}`}>
      {typeLabels[lang][item.type] || item.type}
    </span>
    <time class="text-sm text-primary/50">{item.date}</time>
  </div>
  <h3 class="text-lg font-serif font-bold text-primary mb-2 leading-snug">
    {lang === 'zh' ? item.title.zh : item.title.en}
  </h3>
  {showBody && (
    <p class="text-sm text-primary/70 leading-relaxed">
      {lang === 'zh' ? item.body?.zh : item.body?.en}
    </p>
  )}
</article>
