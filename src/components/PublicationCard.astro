---
interface Props {
  pub: any;
  lang: 'zh' | 'en';
}
const { pub, lang } = Astro.props;
const t = (zh, en) => lang === 'zh' ? zh : en;

const authorList = Array.isArray(pub.authors) ? pub.authors.join(', ') : pub.authors;
---

<article class={`card card-hover p-6 ${pub.highlight ? 'border-l-4 border-accent' : ''}`}>
  <div class="flex items-start justify-between gap-4 mb-2">
    <span class="text-sm font-bold text-accent-dark">{pub.year}</span>
    <div class="flex gap-1.5 flex-wrap justify-end">
      {pub.tags?.map(tag => <span class="tag text-xs">{tag}</span>)}
    </div>
  </div>
  <h3 class="text-lg font-serif font-bold text-primary mb-2 leading-snug">
    {pub.title}
  </h3>
  <p class="text-sm text-primary/60 mb-1">{authorList}</p>
  <p class="text-sm text-primary/50 mb-3 italic">
    {pub.venue}{pub.volume ? `, ${pub.volume}` : ''}{pub.pages ? `:${pub.pages}` : ''}
  </p>
  {pub.summary && (
    <p class="text-sm text-primary/70 mb-3 leading-relaxed">
      {lang === 'zh' ? pub.summary.zh : pub.summary.en}
    </p>
  )}
  <div class="flex flex-wrap gap-3 text-sm">
    {pub.doi && <a href={pub.doi} class="link-accent" target="_blank" rel="noopener">DOI</a>}
    {pub.pdf && <a href={pub.pdf} class="link-accent" target="_blank" rel="noopener">PDF</a>}
    {pub.code && <a href={pub.code} class="link-accent" target="_blank" rel="noopener">Code</a>}
    {pub.data && <a href={pub.data} class="link-accent" target="_blank" rel="noopener">Data</a>}
    {pub.pubmed && <a href={pub.pubmed} class="link-accent" target="_blank" rel="noopener">PubMed</a>}
    {pub.scholar && <a href={pub.scholar} class="link-accent" target="_blank" rel="noopener">Scholar</a>}
  </div>
</article>
