---
import BaseLayout from '../layouts/BaseLayout.astro';
import membersData from '../data/members.yml';

const lang = 'zh';

// 统一 base 前缀
const base = import.meta.env.BASE_URL;
const asset = (p) => (p ? `${base}${String(p).replace(/^\//, '')}` : p);

const pi = membersData[0];
const currentMembers = membersData.filter(m => m.status === 'current' && m.id !== pi.id);
---

<BaseLayout lang={lang} current="/people" title="成员与校友">
  <!-- Header -->
  <section class="neural-bg border-b border-primary/5">
    <div class="container-content py-16">
      <h1 class="text-4xl lg:text-5xl font-serif font-bold text-primary mb-4">成员与校友</h1>
      <p class="text-lg text-primary/60">People & Alumni</p>
    </div>
  </section>

  <!-- PI Highlight -->
  <section class="py-16">
    <div class="container-content">
      <h2 class="section-title">课题组组长</h2>
      <div class="pi-card">
        <div class="flex flex-col md:flex-row gap-8">
          <div class="shrink-0 flex flex-col items-center">
            <img
              src={asset(pi.photo)}
              alt={pi.name.zh}
              class="w-40 h-40 lg:w-48 lg:h-48 rounded-2xl object-cover shadow-card-hover"
              onerror={`this.src='${base}images/people/placeholder.svg'`}
            />
            <span class="mt-3 px-3 py-1 bg-accent text-white text-xs rounded-full font-medium">PI</span>
          </div>
          <div class="flex-1">
            <h3 class="text-2xl font-serif font-bold text-primary mb-1">{pi.name.zh}</h3>
            <p class="text-accent-dark font-medium mb-1">{pi.role.zh}</p>
            <p class="text-sm text-primary/40 mb-4 italic">{pi.name.en} · {pi.role.en}</p>
            
            <div class="mb-4">
              <p class="text-sm font-medium text-primary/50 mb-1">教育背景与经历</p>
              <p class="text-primary/70 leading-relaxed">{pi.bio.zh}</p>
            </div>
            
            <div class="mb-4">
              <p class="text-sm font-medium text-primary/50 mb-1">研究方向</p>
              <p class="text-primary/80">{pi.research.zh}</p>
            </div>

            {pi.links && (pi.links.email || pi.links.github || pi.links.scholar || pi.links.orcid) && (
              <div class="flex flex-wrap gap-4 text-sm mt-6 pt-4 border-t border-primary/5">
                {pi.links.email && <a href={`mailto:${pi.links.email}`} class="link-accent">Email</a>}
                {pi.links.github && <a href={pi.links.github} class="link-accent" target="_blank" rel="noopener">GitHub</a>}
                {pi.links.scholar && <a href={pi.links.scholar} class="link-accent" target="_blank" rel="noopener">Google Scholar</a>}
                {pi.links.orcid && <a href={pi.links.orcid} class="link-accent" target="_blank" rel="noopener">ORCID</a>}
                <a href={`${base}files/CV_Meng_Hongyu.pdf`} class="link-accent" target="_blank">CV (PDF) →</a>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Members (one-line-per-person, but each row is a card) -->
  <section class="py-16 bg-white border-y border-primary/5">
    <div class="container-content">
      <h2 class="section-title">组成员</h2>
      <p class="section-subtitle">Lab Members</p>
      
      <div class="flex flex-col gap-4 mt-8">
        {currentMembers.map(m => (
          <div class="card p-6 flex flex-row items-start gap-6">
            <img 
              src={asset(m.photo)} 
              alt={m.name.zh} 
              class="w-24 h-24 rounded-2xl object-cover shadow-sm shrink-0" 
              onerror={`this.src='${base}images/people/placeholder.svg'`}
            />
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2">
                <h3 class="text-xl font-serif font-bold text-primary">{m.name.zh}</h3>
                <span class="text-sm text-accent-dark font-medium">{m.role.zh}</span>
              </div>
              <p class="text-sm text-primary/60 mb-2">{m.research?.zh}</p>
              
              {m.bio && m.showBio !== false && m.bio.zh && (
                <p class="text-sm text-primary/50 leading-relaxed mt-2">
                  {m.bio.zh}
                </p>
              )}
            </div>
            {m.links?.email && <a href={`mailto:${m.links.email}`} class="text-primary/40 hover:text-accent mt-2 shrink-0">✉</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Alumni -->
  <section class="py-16">
    <div class="container-content">
      <h2 class="section-title">校友</h2>
      <p class="section-subtitle">Alumni</p>
      <div class="card p-8 text-center text-primary/50">
        <p>暂无校友信息，后续将在此展示。</p>
      </div>
    </div>
  </section>

  <!-- Group Photos -->
  <section class="py-16 bg-white border-y border-primary/5">
    <div class="container-content">
      <h2 class="section-title">组内风采</h2>
      <p class="section-subtitle">Lab Life</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-card overflow-hidden md:col-span-2 bg-surface flex items-center justify-center p-10 border border-primary/10 text-primary/40">
          <p>图片位置：研究院外墙 / 组内风采大图（请替换为真实图片）</p>
        </div>
        <div class="rounded-card overflow-hidden bg-surface flex items-center justify-center aspect-video border border-primary/10 text-primary/40">
           <p>图片位置：组成员合影</p>
        </div>
        <div class="rounded-card overflow-hidden bg-surface flex items-center justify-center aspect-video border border-primary/10 text-primary/40">
           <p>图片位置：组内生活照</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>