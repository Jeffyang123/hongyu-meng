---
import BaseLayout from '../../layouts/BaseLayout.astro';
import membersData from '../../data/members.yml';

const lang = 'en';

// 统一 base 前缀
const base = import.meta.env.BASE_URL;
const asset = (p) => (p ? `${base}${String(p).replace(/^\//, '')}` : p);

const pi = membersData[0];
const currentMembers = membersData.filter(m => m.status === 'current' && m.id !== pi.id);
---

<BaseLayout lang={lang} current="/en/people" title="People & Alumni">
  <!-- Header -->
  <section class="neural-bg border-b border-primary/5">
    <div class="container-content py-16">
      <h1 class="text-4xl lg:text-5xl font-serif font-bold text-primary mb-4">People & Alumni</h1>
      <p class="text-lg text-primary/60">成员与校友</p>
    </div>
  </section>

  <!-- PI Highlight -->
  <section class="py-16">
    <div class="container-content">
      <h2 class="section-title">Principal Investigator</h2>
      <div class="pi-card">
        <div class="flex flex-col md:flex-row gap-8">
          <div class="shrink-0 flex flex-col items-center">
            <img
              src={asset(pi.photo)}
              alt={pi.name.en}
              class="w-40 h-40 lg:w-48 lg:h-48 rounded-2xl object-cover shadow-card-hover"
              onerror={`this.src='${base}images/people/placeholder.svg'`}
            />
            <span class="mt-3 px-3 py-1 bg-accent text-white text-xs rounded-full font-medium">PI</span>
          </div>
          <div class="flex-1">
            <h3 class="text-2xl font-serif font-bold text-primary mb-1">{pi.name.en}</h3>
            <p class="text-accent-dark font-medium mb-1">{pi.role.en}</p>
            <p class="text-sm text-primary/40 mb-4 italic">{pi.name.zh} · {pi.role.zh}</p>
            
            <div class="mb-4">
              <p class="text-sm font-medium text-primary/50 mb-1">Education & Experience</p>
              <p class="text-primary/70 leading-relaxed">{pi.bio.en}</p>
            </div>
            
            <div class="mb-4">
              <p class="text-sm font-medium text-primary/50 mb-1">Research Areas</p>
              <p class="text-primary/80">{pi.research.en}</p>
            </div>

            {pi.links && (pi.links.email || pi.links.github || pi.links.scholar || pi.links.orcid) && (
              <div class="flex flex-wrap gap-4 text-sm mt-6 pt-4 border-t border-primary/5">
                {pi.links.email && <a href={`mailto:${pi.links.email}`} class="link-accent">Email</a>}
                {pi.links.github && <a href={pi.links.github} class="link-accent" target="_blank" rel="noopener">GitHub</a>}
                {pi.links.scholar && <a href={pi.links.scholar} class="link-accent" target="_blank" rel="noopener">Google Scholar</a>}
                {pi.links.orcid && <a href={pi.links.orcid} class="link-accent" target="_blank" rel="noopener">ORCID</a>}
                <a href={`${base}files/CV_Meng_Hongyu.pdf`} class="link-accent" target="_blank">CV (PDF) →</a>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Members (统一为卡片网格，带简介) -->
  <section class="py-16 bg-white border-y border-primary/5">
    <div class="container-content">
      <h2 class="section-title">Lab Members</h2>
      <p class="section-subtitle">Current members</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
        {currentMembers.map(m => (
          <div class="card p-6 flex flex-col items-center text-center">
            <img 
              src={asset(m.photo)} 
              alt={m.name.en} 
              class="w-24 h-24 rounded-full object-cover shadow-sm mb-4" 
              onerror={`this.src='${base}images/people/placeholder.svg'`}
            />
            <h3 class="text-lg font-serif font-bold text-primary mb-1">{m.name.en}</h3>
            <p class="text-sm text-accent-dark font-medium mb-3">{m.role.en}</p>
            
            <p class="text-sm text-primary/60 mb-3">{m.research?.en}</p>
            
            {m.bio && m.showBio !== false && m.bio.en && (
              <p class="text-xs text-primary/50 leading-relaxed mt-2 w-full text-left">
                {m.bio.en}
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Alumni -->
  <section class="py-16">
    <div class="container-content">
      <h2 class="section-title">Alumni</h2>
      <p class="section-subtitle">Former members</p>
      <div class="card p-8 text-center text-primary/50">
        <p>No alumni information yet. This section will be updated soon.</p>
      </div>
    </div>
  </section>

  <!-- Group Photos -->
  <section class="py-16 bg-white border-y border-primary/5">
    <div class="container-content">
      <h2 class="section-title">Lab Life</h2>
      <p class="section-subtitle">组内风采</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-card overflow-hidden md:col-span-2 bg-surface flex items-center justify-center p-10 border border-primary/10 text-primary/40">
          <p>Image Slot: Institute Exterior / Group Overview (Please replace with real images)</p>
        </div>
        <div class="rounded-card overflow-hidden bg-surface flex items-center justify-center aspect-video border border-primary/10 text-primary/40">
           <p>Image Slot: Group Photo</p>
        </div>
        <div class="rounded-card overflow-hidden bg-surface flex items-center justify-center aspect-video border border-primary/10 text-primary/40">
           <p>Image Slot: Lab Life</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>