---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteData from '../../data/site.yml';

const lang = 'en';

const positions = [
  { title: 'Postdoc', zh: '博士后', count: 'Open', req: "PhD in computational neuroscience, machine learning, or a related field. Experience in electrophysiology or computational modeling preferred." },
  { title: 'PhD Student', zh: '博士研究生', count: 'Open', req: "Bachelor's or master's degree in mathematics, physics, computer science, neuroscience, or a related field, with strong interest in computational neuroscience." },
  { title: 'Master Student', zh: '硕士研究生', count: 'Open', req: "Bachelor's degree in a related field, with a solid foundation in programming and mathematics." },
  { title: 'Research Assistant', zh: '研究助理', count: 'Open', req: "Bachelor's degree or above. Responsible for experimental data analysis and simulation platform maintenance." },
  { title: 'Undergraduate / Intern', zh: '本科毕设/实习生', count: 'Open', req: "Current undergraduate students who can complete a thesis project or a short-term internship in the lab." },
];

const faqs = [
  { q: 'What background is required?', a: 'Computational neuroscience, applied mathematics, physics, computer science, electrical engineering, and related fields are all welcome. The key is a genuine passion for brain computation and brain-inspired AI.' },
  { q: 'What are the English requirements?', a: 'Ability to read English literature and write English papers is required. PhD students and postdocs should have good spoken English for international conferences.' },
  { q: 'What is the research environment like?', a: 'The lab is based at the Guangdong Institute of Intelligence Science and Technology (GIIST), with strong computing resources and experimental platforms, and maintains close collaborations with universities in China and abroad.' },
  { q: 'What is the application process?', a: 'Please send your CV (including research experience and representative work) to the recruitment email, with the position you are applying for in the subject line. Interviews will be arranged after initial review.' },
];
---

<BaseLayout lang={lang} current="/join" title="Join Us">
  <section class="neural-bg border-b border-primary/5">
    <div class="container-content py-16">
      <h1 class="text-4xl lg:text-5xl font-serif font-bold text-primary mb-4">Join Us</h1>
      <p class="text-lg text-primary/60 max-w-2xl">
        We welcome students and researchers passionate about predictive coding, computational neuroscience, and brain-inspired AI to join our lab!
      </p>
    </div>
  </section>

  <!-- Simplified Recruitment -->
  <section class="py-16">
    <div class="container-content">
      <h2 class="section-title">We Are Hiring</h2>
      <p class="section-subtitle">长期招聘</p>

      <div class="card p-8 lg:p-10">
        <div class="flex flex-wrap gap-3 mb-6">
          {['PhD', 'Postdoc', 'Graduate', 'Research Assistant', 'Intern'].map(p => (
            <span class="px-4 py-2 bg-accent/10 text-accent-dark rounded-full font-medium text-sm">{p}</span>
          ))}
        </div>

        <div class="space-y-4">
          <div>
            <h3 class="text-lg font-serif font-bold text-primary mb-2">Basic Requirements</h3>
            <ul class="space-y-2 text-primary/70 leading-relaxed">
              <li class="flex gap-2"><span class="text-accent-dark shrink-0">•</span> Background in computational neuroscience, applied mathematics, physics, computer science, electrical engineering, or a related field</li>
              <li class="flex gap-2"><span class="text-accent-dark shrink-0">•</span> Strong interest in brain computation and brain-inspired AI</li>
              <li class="flex gap-2"><span class="text-accent-dark shrink-0">•</span> Solid foundation in programming and mathematics; able to read English literature and write English papers</li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-serif font-bold text-primary mb-2">What We Offer</h3>
            <ul class="space-y-2 text-primary/70 leading-relaxed">
              <li class="flex gap-2"><span class="text-accent-dark shrink-0">•</span> Ample computing resources and experimental platforms at the Guangdong Institute of Intelligence Science and Technology</li>
              <li class="flex gap-2"><span class="text-accent-dark shrink-0">•</span> Close collaboration and exchange opportunities with universities including NYU and Northwestern</li>
              <li class="flex gap-2"><span class="text-accent-dark shrink-0">•</span> Competitive compensation and clear room for growth</li>
            </ul>
          </div>
        </div>

        <!-- Toggle: Detailed Positions -->
        <details class="mt-8 group">
          <summary class="cursor-pointer text-accent-dark font-medium flex items-center gap-2 hover:text-accent">
            View detailed requirements for each position
            <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></svg>
          </summary>
          <div class="grid md:grid-cols-2 gap-4 mt-4">
            {positions.map(p => (
              <div class="card p-5 border border-primary/5">
                <div class="flex items-center justify-between mb-2">
                  <h4 class="font-serif font-bold text-primary">{p.title}</h4>
                  <span class="tag text-xs">{p.count}</span>
                </div>
                <p class="text-xs text-primary/40 mb-2">{p.zh}</p>
                <p class="text-sm text-primary/70 leading-relaxed">{p.req}</p>
              </div>
            ))}
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- How to Apply -->
  <section class="py-16 bg-white border-y border-primary/5">
    <div class="container-content">
      <h2 class="section-title">How to Apply</h2>
      <div class="card p-8">
        <ol class="space-y-4">
          <li class="flex gap-4">
            <span class="w-8 h-8 rounded-full bg-accent/10 text-accent-dark font-bold flex items-center justify-center shrink-0">1</span>
            <div>
              <p class="font-medium text-primary mb-1">Prepare Your Materials</p>
              <p class="text-sm text-primary/60">A CV (education, research experience, representative work) and a research statement (1-2 pages).</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="w-8 h-8 rounded-full bg-accent/10 text-accent-dark font-bold flex items-center justify-center shrink-0">2</span>
            <div>
              <p class="font-medium text-primary mb-1">Send an Email</p>
              <p class="text-sm text-primary/60">
                Send to <a href={`mailto:${siteData.email}`} class="link-accent">{siteData.email}</a>,
                with subject: <strong>[Position] Name - Institution</strong>
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="w-8 h-8 rounded-full bg-accent/10 text-accent-dark font-bold flex items-center justify-center shrink-0">3</span>
            <div>
              <p class="font-medium text-primary mb-1">Interview</p>
              <p class="text-sm text-primary/60">An online or in-person interview to discuss your research interests and fit with the lab.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="w-8 h-8 rounded-full bg-accent/10 text-accent-dark font-bold flex items-center justify-center shrink-0">4</span>
            <div>
              <p class="font-medium text-primary mb-1">Offer</p>
              <p class="text-sm text-primary/60">A formal offer letter will be issued after the interview, with assistance for onboarding/enrollment.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16">
    <div class="container-content">
      <h2 class="section-title">FAQ</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="card p-6 group">
            <summary class="font-serif font-bold text-primary cursor-pointer flex items-center justify-between">
              {faq.q}
              <svg class="w-5 h-5 text-accent transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></svg>
            </summary>
            <p class="text-primary/70 mt-3 leading-relaxed">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary text-white">
    <div class="container-content text-center">
      <h2 class="text-2xl font-serif font-bold mb-4">Ready to join us?</h2>
      <p class="text-white/70 mb-6">Send your application to start your research journey.</p>
      <a href={`mailto:${siteData.email}`} class="btn-accent">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1 0 2 1 2 2v12c0 1-1 2-2 2H4c-1 0-2-1-2-2V6c0-1 1-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
        {siteData.email}
      </a>
    </div>
  </section>
</BaseLayout>