---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import MemberCard from '../components/MemberCard.astro';
import NewsCard from '../components/NewsCard.astro';
import siteData from '../data/site.yml';
import membersData from '../data/members.yml';
import publicationsData from '../data/publications.yml';
import newsData from '../data/news.yml';
import researchData from '../data/research.yml';

const lang = 'zh';

// 统一 base 前缀，GitHub Pages 上为 /hongyu-meng/
const base = import.meta.env.BASE_URL;
// 把 YAML 中以 / 开头的资源路径加上 base
const asset = (p) => (p ? `${base}${String(p).replace(/^\//, '')}` : p);

// PI：固定取第一位
const pi = membersData[0];

// 首页团队成员：只取 featured === true 的当前成员（不含 PI），最多 6 位
const teamMembers = membersData
  .filter(m => m.status === 'current' && m.featured === true && m.id !== pi.id)
  .slice(0, 6);

const recentPubs = publicationsData.slice(0, 3);
const recentNews = newsData.slice(0, 3);

// V2: 根据关键词数量动态计算网格列数
const kwCount = researchData.keywords.length;
const kwGridClass = kwCount <= 2 ? 'grid-cols-2'
  : kwCount <= 4 ? 'grid-cols-2 lg:grid-cols-4'
  : kwCount <= 6 ? 'grid-cols-2 lg:grid-cols-3'
  : 'grid-cols-2 lg:grid-cols-4';
---

<BaseLayout lang={lang} current="/">
  <!-- Hero -->
  <section class="relative overflow-hidden neural-bg">
    <div class="absolute inset-0 grid-pattern opacity-50"></div>
    <div class="container-content relative py-20 lg:py-28">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="fade-in-up">
          <p class="text-accent-dark font-medium mb-4 tracking-wide">{siteData.institute_zh}</p>
          <h1 class="text-4xl lg:text-5xl font-serif font-bold text-primary mb-4 leading-tight">
            {siteData.title_zh}
          </h1>
          <p class="text-lg lg:text-xl text-primary/60 mb-2">
            {siteData.title_en}
          </p>
          <p class="text-base text-primary/70 mb-8 leading-relaxed max-w-lg">
            {siteData.description_zh}
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={`${base}research/`} class="btn-primary">
              研究方向
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
            </a>
            <a href={`${base}publications/`} class="btn-outline">Publications</a>
            <a href={`${base}join/`} class="btn-accent">加入我们</a>
          </div>
        </div>
        <div class="flex justify-center lg:justify-end fade-in-up">
          <div class="relative">
            <div class="w-64 h-64 lg:w-80 lg:h-80 rounded-2xl overflow-hidden shadow-card-hover bg-primary/5">
              <img
                src={asset(pi.photo)}
                alt={pi.name.zh}
                class="w-full h-full object-cover"
                onerror={`this.src='${base}images/people/placeholder-1.jpg'`}
              />
            </div>
            <div class="absolute -bottom-4 -left-4 card px-5 py-3">
              <p class="font-serif font-bold text-primary">{pi.name.zh}</p>
              <p class="text-sm text-accent-dark">{pi.role.zh}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Keywords：V2 支持可选图片，数量可增减 -->
  <section class="py-12 bg-white border-y border-primary/5">
    <div class="container-content">
      <div class={`grid ${kwGridClass} gap-4`}>
        {researchData.keywords.map(kw => (
          <div class="text-center p-4 rounded-card bg-surface overflow-hidden">
            {kw.image ? (
              <div class="mb-3 rounded-lg overflow-hidden bg-primary/5" style="aspect-ratio: 16/9;">
                <img
                  src={asset(kw.image)}
                  alt={kw.zh}
                  class={`w-full h-full object-${kw.image_size || 'cover'}`}
                  onerror="this.style.display='none';"
                />
              </div>
            ) : null}
            <p class="font-serif font-bold text-primary text-lg">{kw.zh}</p>
            <p class="text-sm text-primary/50 mt-1">{kw.en}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recent Publications -->
  <section class="py-16">
    <div class="container-content">
      <div class="flex items-end justify-between mb-8">
        <div>
          <h2 class="section-title">近期论文</h2>
          <p class="section-subtitle">Recent Publications</p>
        </div>
        <a href={`${base}publications/`} class="link-accent text-sm font-medium">查看全部 →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {recentPubs.map(pub => <PublicationCard pub={pub} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="py-16 bg-white border-y border-primary/5">
    <div class="container-content">
      <div class="flex items-end justify-between mb-8">
        <div>
          <h2 class="section-title">团队成员</h2>
          <p class="section-subtitle">Our Team</p>
        </div>
        <a href={`${base}people/`} class="link-accent text-sm font-medium">查看全部 →</a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4">
        <MemberCard member={pi} lang={lang} isPI={true} />
        {teamMembers.map(m => <MemberCard member={m} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- News -->
  <section class="py-16">
    <div class="container-content">
      <div class="flex items-end justify-between mb-8">
        <div>
          <h2 class="section-title">新闻动态</h2>
          <p class="section-subtitle">Latest News</p>
        </div>
        <a href={`${base}news/`} class="link-accent text-sm font-medium">查看全部 →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {recentNews.map(item => <NewsCard item={item} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- Join CTA -->
  <section class="py-16 bg-primary text-white">
    <div class="container-content text-center">
      <h2 class="text-3xl lg:text-4xl font-serif font-bold mb-4">加入我们</h2>
      <p class="text-lg text-white/70 mb-8 max-w-2xl mx-auto">
        课题组长期招聘博士后、博士研究生、硕士研究生、研究助理及本科毕设学生，欢迎有志于计算神经科学与类脑智能的同学加入。
      </p>
      <a href={`${base}join/`} class="btn-accent inline-flex items-center gap-2">
        查看招聘详情
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
      </a>
    </div>
  </section>
</BaseLayout>